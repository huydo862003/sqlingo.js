{
  "$schema": "https://typedoc.org/schema.json",
  "hostedBaseUrl": "https://huydo862003.github.io/sqlingo.js/api-reference/",
  "entryPoints": ["src/index.ts"],
  "out": "../../doc/api-reference",
  "plugin": ["typedoc-github-theme"],
  "theme": "typedoc-github-theme",
  "excludePrivate": true,
  "excludeProtected": false,
  "excludeExternals": true,
  "externalPattern": ["**/expressions/**"],
  "excludeInternal": false,
  "readme": "README.md",
  "includeVersion": true,
  "skipErrorChecking": true,
  "sort": ["source-order"],
  "categorizeByGroup": true,
  "defaultCategory": "Other",
  "categoryOrder": [
    "Expressions",
    "Tokens",
    "Parser",
    "Generator",
    "Dialects",
    "*"
  ],
  "searchInComments": true,
  "searchInDocuments": true,
  "cleanOutputDir": true,
  "visibilityFilters": {
    "protected": false,
    "private": false,
    "inherited": true,
    "external": false
  },
  "navigation": {
    "includeCategories": true,
    "includeGroups": true
  },
  "navigationLinks": {
    "Home": "https://huydo862003.github.io/sqlingo.js/",
    "GitHub": "https://github.com/huydo862003/sqlingo.js",
    "Original SQLGlot": "https://sqlglot.com"
  },
  "name": "@hdnax/sqlingo.js",
  "includeHierarchySummary": true
}
